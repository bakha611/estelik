# Copy to .env (scripts/setup.sh does this for you and fills in a random DB password).
# All variables: https://docs.immich.app/install/environment-variables

# Where photos/videos live. Put this on your BIGGEST disk — this is your storage cap.
#   Linux example:   /mnt/data/estelik/library
#   Windows example: D:/estelik/library   (forward slashes)
UPLOAD_LOCATION=./library

# Database files. Must be a LOCAL disk (SSD preferred), never a network share.
DB_DATA_LOCATION=./postgres

# Kazakhstan has been on a single UTC+5 zone since March 2024.
TZ=Asia/Almaty

# Pinned to the current stable release. Bump deliberately after reading release notes.
IMMICH_VERSION=v3.3.6

# Letters and digits only. setup.sh replaces this automatically.
DB_PASSWORD=change_me

###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
